---
layout: default
---
{% if site.title == 'blank' %}
  {% assign full_name = site.first_name %}
  {% if site.middle_name %}
    {% assign full_name = full_name | append: ' ' | append: site.middle_name %}
  {% endif %}
  {% assign full_name = full_name | append: ' ' | append: site.last_name %}
{% else %}
  {% assign full_name = site.title %}
{% endif %}

<div class="home-page">
  <aside class="home-rail" aria-label="Profile">
    <div class="home-profile-card">
      {% if page.profile.image %}
        {% assign profile_image_path = page.profile.image | prepend: 'assets/img/' %}
        {%
          include figure.liquid
          loading="eager"
          path=profile_image_path
          class="home-profile-card__image"
          sizes="(min-width: 992px) 280px, 35vw"
          alt=full_name
          cache_bust=true
        %}
      {% endif %}
      <div class="home-profile-card__body">
        <p class="home-profile-card__name">{{ full_name | strip }}</p>
        <p class="home-profile-card__role">M.S. Electrical Engineering</p>
        <p class="home-profile-card__lab">University of Rhode Island · ECBE</p>

        {% if page.profile.more_info %}
          <div class="home-profile-card__meta">{{ page.profile.more_info }}</div>
        {% endif %}

        <div class="home-profile-card__links">
          <a href="mailto:{{ site.data.socials.email }}">Email</a>
          <a href="https://github.com/{{ site.data.socials.github_username }}" rel="external nofollow noopener" target="_blank">GitHub</a>
          <a
            href="https://www.linkedin.com/in/{{ site.data.socials.linkedin_username }}/"
            rel="external nofollow noopener"
            target="_blank"
          >
            LinkedIn
          </a>
          <a href="{{ site.data.socials.cv_pdf | relative_url }}">CV</a>
        </div>
      </div>
    </div>
  </aside>

  <main class="home-main">
    <header class="post-header about-header">
      <p class="home-eyebrow">Clinical AI · Computer Vision · Neural Signals</p>
      <h1 class="post-title">{{ full_name | strip }}</h1>
      <p class="desc">{{ page.subtitle }}</p>
    </header>

    <article>
      {{ content }}

      {% if site.newsletter and site.newsletter.enabled and site.footer_fixed %}
        {% include newsletter.liquid center=true %}
      {% endif %}
    </article>
  </main>
</div>
